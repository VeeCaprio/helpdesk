# Docker Compose — HelpDesk
# Salin file ini menjadi .env lalu ganti nilai password.
COMPOSE_PROJECT_NAME=helpdesk
PROJECT_NAME=helpdesk

# Host ports (hindari bentrok dengan project lain)
NGINX_HTTP_PORT=8083
NGINX_HTTPS_PORT=8444
DB_FORWARD_PORT=13308

# MariaDB (nilai password WAJIB diganti, jangan commit .env)
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
